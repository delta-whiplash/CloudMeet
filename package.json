{
  "name": "cloudmeet",
  "version": "1.0.0",
  "description": "Open-source Calendly alternative running on Cloudflare's free tier. Meeting scheduler with Google Calendar and Outlook sync.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npm run build && wrangler pages dev .svelte-kit/cloudflare",
    "dev:watch": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "db:init": "wrangler d1 execute cloudmeet --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute cloudmeet --file=./schema.sql",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
    "verify-deployment": "node scripts/verify-deployment.js",
    "prebuild": "node scripts/prebuild.js"
  },
  "keywords": [
    "calendly",
    "meeting-scheduler",
    "cloudflare",
    "svelte",
    "sveltekit",
    "google-calendar"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/cloudmeet"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/validator": "^13.15.10",
    "svelte": "^5.56.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.120.1"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.5.4",
    "isomorphic-dompurify": "^3.22.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "validator": "^13.15.35"
  }
}
